{
    "name": "ukspcal",
    "private": true,
    "version": "0.7.2",
    "type": "module",
    "scripts": {
        "dev": "vite dev --host 0.0.0.0",
        "build": "vite build && node scripts/check-sw.mjs",
        "preview": "vite preview --host 0.0.0.0",
        "prepare": "svelte-kit sync || echo ''",
        "hooks:install": "node scripts/install-git-hooks.mjs",
        "commitmsg:check": "node scripts/validate-commit-msg.mjs",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "test": "vitest run",
        "test:tz": "for tz in Pacific/Honolulu America/Los_Angeles America/Toronto Europe/London Asia/Kolkata Asia/Tokyo Pacific/Auckland Pacific/Kiritimati; do echo \"== $tz\"; TZ=$tz vitest run || exit 1; done",
        "test:watch": "vitest --watch",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "test:print:visual": "playwright test e2e/print-calendar.spec.ts",
        "test:print:visual:update": "playwright test e2e/print-calendar.spec.ts --update-snapshots",
        "release:prepare": "node scripts/release.mjs",
        "release": "npm run check && npm run test && npm run test:print:visual && node scripts/release.mjs --commit --tag",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@vercel/analytics": "^2.0.1",
        "flag-icons": "^7.6.0",
        "flowbite": "^4.0.1",
        "flowbite-svelte": "^1.31.0",
        "flowbite-svelte-icons": "^3.1.0",
        "markdown-it": "^15.0.3"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@sveltejs/adapter-vercel": "^7.0.2",
        "@sveltejs/kit": "^3.1.1",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/svelte": "^5.4.2",
        "@testing-library/user-event": "^14.6.8",
        "@types/markdown-it": "^14.2.0",
        "@types/node": "^26.6.6",
        "@vite-pwa/sveltekit": "^2.0.0",
        "@vitest/coverage-v8": "^5.1.0",
        "@vitest/ui": "^5.1.0",
        "jsdom": "^30.1.3",
        "prettier": "^3.9.10",
        "prettier-plugin-svelte": "^4.1.1",
        "svelte": "^5.57.3",
        "svelte-check": "^4.7.8",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "vite": "^8.3.5",
        "vitest": "^5.1.0"
    },
    "imports": {
        "#lib/*": "./src/lib/*"
    }
}
